#!/usr/bin/env bash
# The ship worker's launcher (README.md). A project is a git checkout with a
# `.shipyard.json` at its root; <project> is any checkout of it (a linked
# worktree is fine).
#
#   bin/shipyard start <project> [--if-queued]   start its worker unless one runs
#   bin/shipyard poll                            start --if-queued for each
#                                                project in ~/.config/shipyard/projects
#   bin/shipyard list <project> [--summary [since]]
#   bin/shipyard wait <project> <pr>             exit 0 only when the ship is live
#   bin/shipyard watch <project> <pr> [-- cmd]   wait (or cmd) in a Rex pane; prints its block
#   bin/shipyard check                           this repository's own gate
#
# `start` returns at once. The worker runs from its own clone of this
# repository, ~/.cache/shipyard/<name>/app, and its own clone of the project,
# .../repo, both reset to origin/main at every start, so it runs merged code
# under the project's merged config. It gates each entry in a linked
# worktree of the project clone, .../entry, and rolls from a second clone,
# .../roll, which its first roll makes. None is a worktree of a working
# checkout. It runs with the project's deploy secrets (the roll's settings
# and NTFY_TOPIC, from fnox's deploy tier; run_worker), runs in its own session (so it outlives the command that
# started it), holds `caffeinate -i` where there is one, logs to
# .../logs/worker.log, and exits once the queue is empty and no roll runs or
# waits. `--if-queued` starts it only when a PR carries the `ship` label.
# Where a Rex server runs, the worker runs in the Rex session Shipyard, in a
# tab named for the project that shows its log and status. The tab closes
# when the worker ends cleanly, and the session with its last tab; a worker
# that fails keeps its tab until Enter. Elsewhere (launchd before login,
# SHIPYARD_REX=0) it runs detached.
#
# `watch` is `wait` where an agent or Billy can see it: a pane below the
# Rex pane it's called from ($REX_BLOCK), not in focus, or a tab in the
# session Shipyard when it isn't called from one. It prints the pane's
# block; `rex wait -s <session> <block> --for 9m` returns wait's exit status
# once the ship ends (repeat it on a timeout), and `rex capture` reads the
# result. The pane stays until it's closed. Without Rex it is `wait`.
set -euo pipefail

self=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
say() { echo "shipyard: $*"; }
die() { echo "shipyard: $*" >&2; exit 64; }
usage() { sed -n '5,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 64; }

# The project checkout's toplevel and its config's fields.
project() {
  [ -n "${1:-}" ] || usage
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || die "$1 is not a git checkout"
  config=$top/.shipyard.json
  [ -f "$config" ] || die "$top has no .shipyard.json"
  name=$(jq -er .name "$config") || die "$config names no project"
  slug=$(jq -er .repo "$config") || die "$config names no repo"
  home=$HOME/.cache/shipyard/$name
}

# The app in $1, compiled for `mix run` or a task, with this repository's
# toolchain (its .tool-versions), not the project's.
mix_in() {
  local dir=$1
  shift
  (cd "$dir" && unset MIX_ENV && mix "$@")
}

start() {
  local if_queued=false
  project "${1:-}"
  case "${2:-}" in
    "") ;;
    --if-queued) if_queued=true ;;
    *) usage ;;
  esac

  # The worker gates on the project's Sprite pool through this machine's
  # `sprite` login; a machine without it leaves the PR queued.
  if ! command -v sprite >/dev/null; then
    say "no sprite CLI on this machine; the PR waits in the queue for the laptop's worker"
    exit 0
  fi

  mkdir -p "$home/logs"
  # Global, not local: the EXIT trap runs after start() has returned.
  start_lock=$home/start.lock
  for _ in $(seq 100); do mkdir "$start_lock" 2>/dev/null && break || sleep 0.2; done
  [ -d "$start_lock" ] || { say "$start_lock is held; remove it if no start is under way"; exit 1; }
  trap 'rmdir "$start_lock"' EXIT

  if [ -f "$home/worker.pid" ] && kill -0 "$(cat "$home/worker.pid")" 2>/dev/null; then
    [ "$if_queued" = true ] || say "$name: running (pid $(cat "$home/worker.pid")); it takes the PR from the queue"
    exit 0
  fi

  # A labeled PR is open in the queue, or merged and waiting for its roll.
  if [ "$if_queued" = true ] &&
    [ -z "$(gh pr list --repo "$slug" --label ship --state all --json number,state --jq '.[] | select(.state != "CLOSED") | .number')" ]; then
    exit 0
  fi

  local repo=$home/repo entry=$home/entry app=$home/app
  local origin self_origin
  origin=$(git -C "$top" remote get-url origin)
  self_origin=$(git -C "$self" remote get-url origin)

  [ -d "$repo/.git" ] || git clone -q "$origin" "$repo"
  git -C "$repo" fetch -q origin
  git -C "$repo" checkout -q --force --detach origin/main
  [ -f "$repo/.shipyard.json" ] || die "origin/main of $slug has no .shipyard.json yet"
  [ -d "$entry" ] || git -C "$repo" worktree add -q --detach "$entry" origin/main

  [ -d "$app/.git" ] || git clone -q "$self_origin" "$app"
  git -C "$app" fetch -q origin
  git -C "$app" checkout -q --force --detach origin/main
  mix_in "$app" compile >>"$home/logs/worker.log" 2>&1 || die "the worker does not compile; see $home/logs/worker.log"

  rm -f "$home/worker.pid"
  if worker_tab; then
    where="in Rex (session $rex_session, tab $name)"
  else
    # Its own session, so it outlives whatever started it: an agent harness
    # kills a command's process group when the command ends. macOS has no
    # setsid binary; perl's exec keeps the pid that worker.pid records.
    nohup perl -MPOSIX=setsid -e 'setsid() or die "setsid: $!\n"; exec @ARGV or die "exec: $!\n"' \
      env -u SHIPYARD_STATUS_TTY "$self/bin/shipyard" _worker "$top" >>"$home/logs/worker.log" 2>&1 </dev/null &
    echo $! >"$home/worker.pid"
    where=detached
  fi
  say "$name: started $where (pid $(cat "$home/worker.pid")) at $(git -C "$repo" rev-parse --short HEAD), worker $(git -C "$app" rev-parse --short HEAD); log: $home/logs/worker.log"
}

# The Rex session the workers' tabs are in.
rex_session=Shipyard

# rex without starting a server: a machine with no Rex running (launchd's
# poll before login) runs the worker detached.
rexc() { rex --autostart=false "$@"; }

# Whether a Rex server runs here to open tabs in.
rex_here() { command -v rex >/dev/null && rexc whoami >/dev/null 2>&1; }

# Opens a tab labeled $2 at $3 running the rest, not in focus, in session
# $1 (an id), or in the session labeled $rex_session when $1 is empty,
# which it creates when there is none. Prints the session's id and the
# tab's block. The tab stays open once its command ends unless $keep is
# empty.
rex_tab() {
  local session=$1 label=$2 dir=$3 out
  shift 3
  local open=(${keep---keep-open})
  [ -n "$session" ] ||
    session=$(rexc ls --json | jq -r --arg l "$rex_session" '[.sessions[] | select(.label == $l)][0].session_id // empty')
  if [ -n "$session" ]; then
    out=$(rexc window new -s "$session" "$label" -c "$dir" ${open[@]+"${open[@]}"} --focus=false --json -- "$@") &&
      echo "$session $(jq -er '.block_ids[0]' <<<"$out")"
  else
    out=$(rexc new "$rex_session" --window "$label" -c "$dir" ${open[@]+"${open[@]}"} --json -- "$@") &&
      jq -er '"\(.session_id) \(.initial_windows[0].block_ids[0])"' <<<"$out"
  fi
}

# Starts the worker in the tab labeled with the project's name in the Rex
# session $rex_session, replacing the last worker's tab, when a Rex server
# runs here and SHIPYARD_REX is not 0. A Rex terminal outlives whatever
# started it, as the detached worker does, and the tab shows the worker's
# log and status (lib/shipyard/status.ex) while it runs (worker_in_tab).
# Fails, starting nothing, when there's no Rex to start it in.
worker_tab() {
  [ "${SHIPYARD_REX:-1}" != 0 ] && rex_here || return 1
  local session old
  session=$(rexc ls --json | jq -r --arg l "$rex_session" '[.sessions[] | select(.label == $l)][0].session_id // empty')
  if [ -n "$session" ]; then
    for old in $(rexc window ls -s "$session" --json | jq -r --arg l "$name" '.windows[] | select(.label == $l) | .window_id'); do
      rexc window close -s "$session" "$old" >/dev/null || true
    done
  fi
  keep='' rex_tab "$session" "$name" "$home" "$self/bin/shipyard" _worker_tab "$top" >/dev/null || return 1
  # The tab writes the pid as it starts; wait for it, so a second start sees it.
  for _ in $(seq 100); do [ -s "$home/worker.pid" ] && return 0 || sleep 0.1; done
  die "the worker's Rex tab started but wrote no pid to $home/worker.pid"
}

# `wait`, or the command after `--`, in a pane: see watch at the top.
watch() {
  project "${1:-}"
  local pr=${2:-} session block
  [ -n "$pr" ] || usage
  shift 2
  [ "${1:-}" != -- ] || shift
  local cmd=("$@")
  [ ${#cmd[@]} -gt 0 ] || cmd=("$self/bin/shipyard" wait "$top" "$pr")
  if ! rex_here; then
    say "no Rex here; waiting in this terminal" >&2
    exec "${cmd[@]}"
  fi
  if [ -n "${REX_SESSION:-}" ] && [ -n "${REX_BLOCK:-}" ]; then
    session=$REX_SESSION
    block=$(rexc split -s "$session" -b "$REX_BLOCK" --split=below --ratio 30 --label "ship #$pr" \
      -c "$top" --keep-open --focus=false --json -- "${cmd[@]}" | jq -er '.block_ids[0]')
  else
    read -r session block < <(rex_tab "" "ship #$pr" "$top" "${cmd[@]}")
  fi
  [ -n "$block" ] || die "opening a Rex pane to wait in failed"
  echo "$block"
  say "#$pr: waiting in Rex pane 'ship #$pr' (block $block). Then: rex wait -s $session $block --for 9m; rex capture -s $session -b $block --trim | tail -n 40; rex block close -s $session $block" >&2
}

# The worker's tab: the worker, its pid in worker.pid and its output in the
# tab and worker.log. A clean end closes the tab (it has no keep-open), and
# the session too when this was its last tab, so no stray tab stays; a
# failure stays on screen until Enter.
worker_in_tab() {
  project "$1"
  local pid status
  SHIPYARD_STATUS_TTY=$(tty) && export SHIPYARD_STATUS_TTY
  exec > >(tee -a "$home/logs/worker.log") 2>&1
  "$self/bin/shipyard" _worker "$top" &
  pid=$!
  echo "$pid" >"$home/worker.pid"
  status=0
  wait "$pid" || status=$?
  if [ "$status" = 0 ]; then
    [ -n "${REX_SESSION:-}" ] &&
      [ "$(rexc window ls -s "$REX_SESSION" --json | jq '.windows | length')" = 1 ] &&
      rexc session kill "$REX_SESSION" >/dev/null 2>&1
    exit 0
  fi
  say "the worker exited $status; log: $home/logs/worker.log. Enter closes this tab."
  read -r _ || true
  exit "$status"
}

# The worker itself, in this process (the Rex tab's or the detached one):
# `mix run` in the worker's own clone, under caffeinate where there is one,
# with the project's deploy secrets (the roll's settings and NTFY_TOPIC).
# Those come from fnox's deploy tier, named by the fnox.toml in the worker's
# clone of the project (~/dev/rig, "Secrets"); without fnox, bws, or that file, from
# the primary checkout's .env, read as KEY=value lines, never run.
run_worker() {
  project "$1"
  local primary
  primary=$(cd "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
  cd "$home/app"
  secrets=()
  if command -v fnox >/dev/null && command -v bws >/dev/null && [ -f "$home/repo/fnox.toml" ]; then
    secrets=(fnox -c "$home/repo/fnox.toml" -P deploy exec --no-defaults --)
  elif [ -f "$primary/.env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] && export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
    done <"$primary/.env"
  fi
  unset MIX_ENV
  export SHIPYARD_CONFIG=$home/repo/.shipyard.json SHIPYARD_HOME=$home
  keep=()
  command -v caffeinate >/dev/null && keep=(caffeinate -i)
  exec ${secrets[@]+"${secrets[@]}"} ${keep[@]+"${keep[@]}"} mix run --no-halt
}

case "${1:-}" in
  start)
    shift
    start "$@"
    ;;
  poll)
    list=$HOME/.config/shipyard/projects
    [ -f "$list" ] || exit 0
    while IFS= read -r dir; do
      case "$dir" in "" | \#*) continue ;; esac
      "${BASH_SOURCE[0]}" start "${dir/#\~/$HOME}" --if-queued || say "starting $dir failed"
    done <"$list"
    ;;
  list)
    project "${2:-}"
    shift 2
    SHIPYARD_CONFIG=$config mix_in "$self" shipyard.list "$@"
    ;;
  wait)
    project "${2:-}"
    [ -n "${3:-}" ] || usage
    SHIPYARD_CONFIG=$config mix_in "$self" shipyard.wait "$3"
    ;;
  check)
    mix_in "$self" check
    ;;
  watch)
    shift
    watch "$@"
    ;;
  _worker)
    run_worker "${2:-}"
    ;;
  _worker_tab)
    worker_in_tab "${2:-}"
    ;;
  *) usage ;;
esac
